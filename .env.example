# Copy to .env and adjust. .env is gitignored.
#
# Images are pinned. No floating tags for publication-relevant services
# (testbed-architecture.md §4).
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.159.0
POSTGRES_IMAGE=postgres:16.4

# Development database passwords. Bootstrap holds these; the experiment
# runner and agent never receive them.
POSTGRES_A_PASSWORD=fam-dev-password-a
POSTGRES_B_PASSWORD=fam-dev-password-b

# Host ports for the Client-Server API. Development convenience only;
# experiments reach the homeservers inside the Docker network.
HS_A_CS_PORT=8008
HS_B_CS_PORT=8009

# ---------------------------------------------------------------------------
# Secrets and credentials — never commit.
# The research artifact must contain no keys, tokens or access credentials.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.seed
*.secret
secrets.*
credentials.*
**/signing.key
**/*.signing.key

# ---------------------------------------------------------------------------
# Homeserver runtime state.
# Generated per deployment; never part of the reproducible artifact.
# Configuration TEMPLATES are tracked — instantiated configs are not.
# ---------------------------------------------------------------------------
**/homeserver.yaml
**/*.log.config
**/media_store/
**/uploads/
**/homeserver.db
**/homeserver.db-*
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm


# ---------------------------------------------------------------------------
# Node (only if a harness or visualisation needs it)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Containers and local infrastructure overrides
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.docker/

# ---------------------------------------------------------------------------
# Experiment output.
#
# Formal raw data is written OUTSIDE this tree, under $FAM_RESULTS_DIR
# (testbed-architecture.md 22, experimental-protocol.md 37). The guard below
# catches a stray local write; it is not where the data is supposed to go.
#
# Tracked and expected here: results/manifests/, results/schemas/,
# results/processed/, results/figures/. Those ARE the evidence the matrix
# points at. Only bulky, regenerable or environment-specific output is
# excluded.
# ---------------------------------------------------------------------------
results/raw/
**/raw-logs/
**/tmp/
*.pcap
*.pcapng
*.tar.gz
*.zip
*.dump
core.*

# ---------------------------------------------------------------------------
# Manuscript build artifacts (if LaTeX is added later)
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Proprietary-material guard (see docs/research-scope.md §15).
# Belt-and-braces only — the real control is review, not a pattern list.
# ---------------------------------------------------------------------------
chums/
chums-*/
**/proprietary/

# ---------------------------------------------------------------------------
# Task 01 implementation
# ---------------------------------------------------------------------------
.pytest_cache/
*.egg-info/
infrastructure/tls/*.crt

# The research CA exported for a human client's trust store (`make e4-ca`).
# Generated per deployment and regenerable; never part of the artifact.
research-ca.crt
infrastructure/tls/*.key
